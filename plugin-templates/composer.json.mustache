{
	"name" : "{{namespace}}/{{slug}}",
	"version": "{{version}}",
	"description" : "{{title}}",
	"minimum-stability" : "dev",
	"prefer-stable": true,
	"license" : "GPL-2.0-or-later",
	"type" : "wordpress-plugin",
	"keywords" : [
		"gutenberg",
		"wordpress",
		"storepress",
		"plugin"
	],
	"homepage" : "https://github.com/{{namespace}}/{{slug}}#readme",
	"authors" : [
		{
			"name" : "Emran Ahmed",
			"email" : "emran@storepress.com"
		},
		{
			"name" : "StorePress Inc.",
			"email" : "storepresshq@gmail.com"
		}
	],
	"require" : {
        "automattic/jetpack-autoloader": "^v6.0",
        "storepress/admin-utils": "^4.0"
	},
	"require-dev" : {
        "automattic/vipwpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^v1.2",
        "squizlabs/php_codesniffer": "^3.13.6",
        "woocommerce/woocommerce-sniffs": "^2.0.0",
        "phpcompatibility/php-compatibility": "9.3.5",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "php-stubs/woocommerce-stubs": "^v11.1.2",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^v2.0",
        "wp-cli/i18n-command": "^v3.0",
        "wp-coding-standards/wpcs": "^3.4",
        "plugin-check/phpcs-sniffs": "@dev"
	},
	"repositories": [
		{
			"type": "path",
			"url": "./wp-plugin-check/plugin-check/phpcs-sniffs",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload" : {
		"psr-4" : {
			"{{pascaleNamespace}}\\{{slugPascalCase}}\\" : "includes/"
		}
	},
	"config" : {
		"optimize-autoloader" : true,
		"sort-packages" : true,
		"lock": true,
		"platform": {
        	"php": "7.4"
        },
		"allow-plugins" : {
			"dealerdirect/phpcodesniffer-composer-installer" : true,
			"automattic/jetpack-autoloader" : true,
			"phpstan/extension-installer": true
		}
	},
	"scripts" : {
        "phpstan" : "./vendor/bin/phpstan --memory-limit=2G",
        "phpstan-report" : "./vendor/bin/phpstan --memory-limit=4G -vvv > phpstan-report.txt",
        "phpstan-clear" : "./vendor/bin/phpstan clear-result-cache",
        "format" : "./vendor/bin/phpcbf --standard=phpcs.xml",
        "lint-report" : "./vendor/bin/phpcs --standard=phpcs.xml --report-summary --report-source --ignore-annotations --report-full=phpcs-report.txt",
        "lint" : "./vendor/bin/phpcs --standard=phpcs.xml --report=full"
	}
}
